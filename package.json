{
  "name": "agntos",
  "version": "0.1.0",
  "private": true,
  "description": "AgntOS — one-click hosting for Hermes Agent. Control plane (Next.js/Vercel) + data plane (Fly Machines).",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @agntos/web dev",
    "dev:worker": "pnpm --filter @agntos/worker dev",
    "build": "pnpm --filter @agntos/web build",
    "build:worker": "pnpm --filter @agntos/worker build",
    "start": "pnpm --filter @agntos/web start",
    "start:worker": "pnpm --filter @agntos/worker start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "db:generate": "pnpm --filter @agntos/db generate",
    "db:migrate": "pnpm --filter @agntos/db migrate",
    "db:push": "pnpm --filter @agntos/db push",
    "db:studio": "pnpm --filter @agntos/db studio",
    "auth:generate": "pnpm --filter @agntos/web auth:generate"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.7.2"
  }
}
