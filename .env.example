# ─────────────────────────────────────────────────────────────────────────────
# AgntOS environment — copy to `.env` and fill in. ONE file at the repo root
# drives web, worker, and Drizzle migrations (drizzle.config.ts loads ../../.env;
# pg-boss reuses DATABASE_URL).
#
# Only the three CORE vars are required to boot. Everything else unlocks a
# feature when set (the app degrades gracefully without it).
#
# Generate secrets:
#   BETTER_AUTH_SECRET : openssl rand -base64 32
#   ENCRYPTION_KEY     : openssl rand -base64 32     (must decode to 32 bytes)
# ─────────────────────────────────────────────────────────────────────────────

# IMPORTANT on the Railway WORKER, set these explicitly (they gate real behaviour
# and otherwise fail silently): NODE_ENV=production (enables non-payment suspension
# + retention deletion), BETTER_AUTH_URL (email links), COMP_EMAILS, and
# CLOUDFLARE_API_TOKEN (per-agent subdomains). The worker also needs ENCRYPTION_KEY,
# RESEND_API_KEY/EMAIL_FROM, and the Fly + OpenRouter vars.
NODE_ENV=development

# ── Core (required) ──────────────────────────────────────────────────────────
# Railway Postgres connection string (the control-plane DB + pg-boss queue).
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Auth signing secret.
BETTER_AUTH_SECRET=
# Public base URL of the web app (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# Optional: cap the node-postgres pool (default 10).
# DATABASE_POOL_MAX=10
# Optional: verify the Postgres server certificate (harden TLS). Paste the
# provider's CA PEM with newlines as \n. If unset, TLS is on but unverified.
# DATABASE_CA_CERT=

# ── OAuth (optional — enables "Continue with Google") ────────────────────────
GOOGLE_ID=
GOOGLE_SECRET=

# ── Stripe (subscriptions + credit packs) ────────────────────────────────────
# Without these, billing UI is disabled and the launch flow falls back to the
# dev "starter" tier (NODE_ENV != production only).
STRIPE_SECRET_KEY=
# Signing secret of your ONE Stripe webhook endpoint. Point Stripe at
#   {BETTER_AUTH_URL}/api/auth/stripe/webhook   (the Better Auth plugin endpoint)
# which also drives credit packs + lifecycle via onEvent.
STRIPE_WEBHOOK_SECRET=
# Recurring monthly prices created in Stripe (Starter $29 / Pro $49).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# Stripe Tax is enabled in the Stripe dashboard, not here.

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Without RESEND_API_KEY, emails are logged and skipped (dev-friendly). In prod
# this MUST be set or email/password signups can't verify and can't log in.
# EMAIL_FROM must be a Resend-verified sender on your domain.
RESEND_API_KEY=
EMAIL_FROM=AgntOS <hello@agntos.net>

# ── Data plane (Fly Machines) ────────────────────────────────────────────────
FLY_API_TOKEN=
FLY_ORG=
FLY_REGION=syd
# Pin the Hermes image to an IMMUTABLE tag (avoid the mutable :main): either a
# sha tag (ghcr.io/<owner>/agntos-hermes:sha-abc1234) or a released version tag
# (push git tag `agent-v0.1.0` → image tag `v0.1.0`). See .github/workflows/agent-image.yml.
AGENT_IMAGE_REF=

# ── Cloudflare DNS (WORKER — per-agent <slug>.agntos.net subdomains) ─────────
# Without CLOUDFLARE_API_TOKEN the subdomain + cert step is silently skipped and
# every agent's dashboard link is dead. Token needs DNS edit on the zone.
CLOUDFLARE_API_TOKEN=
# The apex domain agents live under (default agntos.net).
AGENT_DOMAIN=agntos.net

# ── Tokens (OpenRouter) ──────────────────────────────────────────────────────
# Provisioning key mints per-user capped runtime keys (the spend cap). REQUIRED
# on the worker.
OPENROUTER_PROVISIONING_KEY=
# Reserved — the control plane does not currently use a shared OpenRouter key
# (each agent gets its own minted key). Safe to leave unset.
# OPENROUTER_API_KEY=

# ── Crypto (BYOK + channel tokens at rest) ───────────────────────────────────
# 32-byte key (base64 or hex). Required to onboard Telegram (token is encrypted
# before it touches the job queue) and to store BYOK keys.
ENCRYPTION_KEY=

# ── Observability ────────────────────────────────────────────────────────────
# Sentry (@sentry/node) activates on both web + worker when SENTRY_DSN is set.
# Set it on BOTH Vercel and Railway so backend job/billing failures are reported.
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Object storage (Cloudflare R2 — add when backups/uploads ship) ───────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Misc ─────────────────────────────────────────────────────────────────────
# Comma-separated emails that get a free (no-charge) account: usable tier without
# a subscription + a one-time wallet grant (for founder / demos / beta testers).
COMP_EMAILS=
# Minimum credit-pack top-up in USD (default 5).
CREDIT_PACK_MIN_USD=5
# Reserved for a future web->worker trigger endpoint (not implemented yet).
# WORKER_SHARED_SECRET=
